# Installed on every Mac by `brew bundle`.
# Machine-specific additions go in Brewfile.local (untracked).
# VS Code extensions are left to VS Code Settings Sync.

# CLI
brew "gh"
brew "gitleaks"

# Shell
brew "fzf"
brew "pure"
brew "zoxide"
brew "zsh-autosuggestions"
brew "zsh-syntax-highlighting"

# macOS
brew "dockutil"
brew "duti"

# Apps
cask "1password"
cask "bartender"
cask "claude"
cask "ghostty"
cask "github"
cask "google-chrome"
cask "raycast"
cask "visual-studio-code"
cask "vlc"
