#!/usr/bin/env bash
# Set up a new Mac, or re-sync an existing one. Safe to re-run.
#
#   ./bootstrap               run the default steps
#   ./bootstrap links github  run only the named steps
#
# New Mac (clones to ~/aluminium, or $ALUMINIUM_DIR):
#   curl -fsSL https://raw.githubusercontent.com/jonmilner/aluminium/main/bootstrap | bash
# A branch, before it merges:
#   curl -fsSL https://raw.githubusercontent.com/jonmilner/aluminium/<branch>/bootstrap | ALUMINIUM_REF=<branch> bash
#
# Written for the stock macOS bash 3.2.

set -eo pipefail

REPO_URL="https://github.com/jonmilner/aluminium.git"
ICLOUD="$HOME/Library/Mobile Documents/com~apple~CloudDocs"
SECRETS="$ICLOUD/dotfiles/secrets.zsh"

# repo path:path under $HOME
LINKS=(
  "home/zshrc:.zshrc"
  "home/gitconfig:.gitconfig"
  "home/npmrc:.npmrc"
  "home/ssh_config:.ssh/config"
  "config/ghostty/config:.config/ghostty/config"
  "config/git/ignore:.config/git/ignore"
)

# Links from older layouts, removed if still present
RETIRED_LINKS=(.gitignore .hyper.js)

# Interactive steps come first (password, GitHub sign-in); the rest runs unattended.
STEPS=(name xcode homebrew github packages vite links secrets macos checklist)

WARNINGS=()

say()  { printf '\n\033[1m→ %s\033[0m\n' "$*"; }
ok()   { printf '  ✓ %s\n' "$*"; }
warn() { printf '  \033[33m! %s\033[0m\n' "$*" >&2; WARNINGS+=("$*"); }

# Steps that use sudo, so they need an administrator account.
SUDO_STEPS=" name xcode homebrew packages macos "

require_admin() {
  id -Gn | tr ' ' '\n' | grep -qx admin && return
  echo "This account ($(id -un)) isn't an administrator, so it can't install software." >&2
  echo "Use an admin account, or turn on \"Allow this user to administer this computer\"" >&2
  echo "for it in System Settings → Users & Groups." >&2
  exit 1
}

# Homebrew belongs to the account that installed it; other accounts can't use it.
brew_writable() {
  [[ -w $HOMEBREW_CELLAR ]] && return
  warn "Homebrew in $HOMEBREW_PREFIX belongs to $(stat -f %Su "$HOMEBREW_PREFIX"), so this account can't install packages. Run this step as that user."
  return 1
}

need_sudo() {
  [[ -n $SUDO_KEEPALIVE ]] && return
  sudo -v
  while true; do sudo -n true; sleep 50; kill -0 "$$" || exit; done 2>/dev/null &
  export SUDO_KEEPALIVE=$!
  trap 'kill $SUDO_KEEPALIVE 2>/dev/null' EXIT
}

load_brew() {
  local b
  for b in /opt/homebrew/bin/brew /usr/local/bin/brew; do
    if [[ -x $b ]]; then eval "$("$b" shellenv)"; return 0; fi
  done
  return 1
}

###############################################################################
# Steps
###############################################################################

# Asks once per Mac. Enter keeps the current name.
step_name() {
  local marker="$HOME/.local/state/aluminium/named" name host input
  [[ -e $marker ]] && return
  need_sudo
  name=$(scutil --get ComputerName)
  read -r -p "  Name for this Mac [$name]: " input || true
  name=${input:-$name}
  # Hostnames allow letters, digits and hyphens only.
  host=$(printf '%s' "$name" | sed "s/[’']//g" | iconv -f utf-8 -t ascii//TRANSLIT 2>/dev/null | tr -cs 'A-Za-z0-9' '-' | sed 's/^-*//; s/-*$//')
  sudo scutil --set ComputerName "$name"
  sudo scutil --set LocalHostName "$host"
  sudo scutil --set HostName "$host"
  mkdir -p "${marker%/*}" && touch "$marker"
  ok "This Mac is $name ($host.local)"
}

step_xcode() {
  local flag=/tmp/.com.apple.dt.CommandLineTools.installondemand.in-progress label
  if xcode-select -p >/dev/null 2>&1; then
    ok "Command Line Tools installed"
    return
  fi
  need_sudo
  # Install without the GUI dialog, the same way Homebrew's installer does.
  touch "$flag"
  label=$(softwareupdate -l 2>/dev/null | sed -n 's/^ *\* Label: //p' | grep 'Command Line Tools' | sort -V | tail -n 1)
  if [[ -n $label ]]; then
    echo "  Installing $label. This takes several minutes…"
    sudo softwareupdate -i "$label"
  fi
  rm -f "$flag"
  if ! xcode-select -p >/dev/null 2>&1; then
    xcode-select --install >/dev/null 2>&1 || true
    echo "  Finish the Command Line Tools installer window. Waiting…"
    until xcode-select -p >/dev/null 2>&1; do sleep 5; done
  fi
  ok "Command Line Tools installed"
}

step_homebrew() {
  if load_brew; then
    ok "Homebrew installed"
    return
  fi
  need_sudo
  NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
  load_brew
  ok "Homebrew installed"
}

# Adopting a hand-installed app means changing its bundle, which macOS blocks
# unless the terminal has App Management permission. Probe one app we own
# (not the terminal itself, which may always modify its own bundle).
can_modify_apps() {
  local app
  for app in /Applications/*.app; do
    [[ -O $app ]] || continue
    [[ $(defaults read "$app/Contents/Info" CFBundleIdentifier 2>/dev/null) == "$__CFBundleIdentifier" ]] && continue
    chgrp "$(stat -f %g "$app")" "$app" 2>/dev/null
    return
  done
  return 0
}

step_packages() {
  load_brew || { warn "Homebrew missing; run: ./bootstrap homebrew"; return; }
  brew_writable || return 0
  if ! can_modify_apps; then
    warn "This terminal can't take over apps installed by hand. Turn it on in System Settings → Privacy & Security → App Management, quit and reopen the terminal, then run: ./bootstrap packages"
    open "x-apple.systempreferences:com.apple.preference.security?Privacy_AppBundles" 2>/dev/null || true
    return
  fi
  need_sudo
  # Casks adopt apps that were installed by hand.
  brew bundle --file="$REPO/Brewfile" || warn "brew bundle reported failures (see above)"
  if [[ -f $REPO/Brewfile.local ]]; then
    brew bundle --file="$REPO/Brewfile.local" || warn "brew bundle (Brewfile.local) reported failures"
  fi
}

step_vite() {
  # Runs before `links`: the installer edits ~/.zshrc, and that edit should land
  # in the pre-link file that gets backed up, not in the repo.
  if [[ -x $HOME/.local/share/vite-plus/bin/vp ]] || command -v vp >/dev/null 2>&1; then
    ok "Vite+ installed"
    return
  fi
  curl -fsSL https://vite.plus | VP_NODE_MANAGER=yes bash
  ok "Vite+ installed"
}

step_links() {
  local entry src rel dst stamp
  stamp=$(date +%Y%m%d-%H%M%S)
  mkdir -p -m 700 "$HOME/.ssh"
  for rel in "${RETIRED_LINKS[@]}"; do
    if [[ -L $HOME/$rel ]]; then
      rm "$HOME/$rel"
      ok "Removed old link ~/$rel"
    fi
  done
  for entry in "${LINKS[@]}"; do
    src="$REPO/${entry%%:*}"
    rel="${entry#*:}"
    dst="$HOME/$rel"
    if [[ -L $dst && "$(readlink "$dst")" == "$src" ]]; then
      ok "~/$rel"
      continue
    fi
    mkdir -p "$(dirname "$dst")"
    if [[ -e $dst || -L $dst ]]; then
      mv "$dst" "$dst.backup-$stamp"
      warn "Moved the old ~/$rel to ~/$rel.backup-$stamp"
    fi
    ln -s "$src" "$dst"
    ok "~/$rel"
  done
}

# The key gets a random passphrase that goes straight into Keychain: it's
# encrypted on disk, and nobody has to type or remember the passphrase.
new_ssh_key() {
  local key=$1 askpass
  SSH_KEY_PASSPHRASE=$(openssl rand -base64 33)
  export SSH_KEY_PASSPHRASE
  ssh-keygen -q -t ed25519 -C "$(id -un)@$(scutil --get LocalHostName)" -f "$key" -N "$SSH_KEY_PASSPHRASE"
  askpass=$(mktemp)
  printf '#!/bin/sh\nprintf "%%s\\n" "$SSH_KEY_PASSPHRASE"\n' >"$askpass"
  chmod 700 "$askpass"
  SSH_ASKPASS=$askpass SSH_ASKPASS_REQUIRE=force ssh-add --apple-use-keychain "$key" </dev/null 2>/dev/null
  rm -f "$askpass"
  unset SSH_KEY_PASSPHRASE
}

step_github() {
  local key="$HOME/.ssh/id_ed25519" pub keys url
  mkdir -p -m 700 "$HOME/.ssh"
  if [[ -f $key ]]; then
    ssh-add --apple-use-keychain "$key" 2>/dev/null
  else
    new_ssh_key "$key"
  fi
  ok "SSH key in Keychain"

  if ! command -v gh >/dev/null 2>&1; then
    load_brew || { warn "Homebrew missing; run: ./bootstrap homebrew github"; return; }
    brew_writable || return 0
    brew install --quiet gh
  fi
  if ! gh auth status >/dev/null 2>&1; then
    echo "  Sign in to GitHub in your browser. This is the last prompt; the rest runs unattended."
    gh auth login --hostname github.com --git-protocol ssh --web --skip-ssh-key --scopes admin:public_key
  fi

  pub=$(cut -d' ' -f2 "$key.pub")
  if ! keys=$(gh ssh-key list 2>/dev/null); then
    gh auth refresh --hostname github.com --scopes admin:public_key
    keys=$(gh ssh-key list)
  fi
  if grep -qF "$pub" <<<"$keys"; then
    ok "SSH key on GitHub"
  else
    gh ssh-key add "$key.pub" --title "$(scutil --get ComputerName)"
    ok "SSH key added to GitHub"
  fi

  # Trust GitHub's host keys from its API (over HTTPS) instead of on first use.
  if ! ssh-keygen -F github.com >/dev/null 2>&1; then
    gh api meta --jq '.ssh_keys[]' | sed 's/^/github.com /' >>"$HOME/.ssh/known_hosts"
    ok "GitHub host keys added to known_hosts"
  fi

  url=$(git -C "$REPO" remote get-url origin)
  if [[ $url == https://github.com/* ]]; then
    git -C "$REPO" remote set-url origin "git@github.com:${url#https://github.com/}"
    ok "Repo remote switched to SSH"
  fi
}

step_secrets() {
  if [[ ! -d $ICLOUD ]]; then
    warn "iCloud Drive isn't on. Sign in to iCloud, turn on iCloud Drive, then run: ./bootstrap secrets"
    return
  fi
  mkdir -p "$(dirname "$SECRETS")"
  # Ask iCloud to download the file if it's only a placeholder on this Mac.
  brctl download "$SECRETS" >/dev/null 2>&1 || true
  if [[ -e $SECRETS ]]; then
    ok "secrets.zsh found in iCloud Drive"
  else
    warn "No secrets file yet. Create iCloud Drive/dotfiles/secrets.zsh with export lines (e.g. NPM_TOKEN_JONMILNER)"
  fi
}

step_macos() {
  need_sudo
  bash "$REPO/macos/set-defaults.sh"
  # Safari's settings live in its sandbox container, which needs Full Disk Access.
  if [[ -d ~/Library/Containers/com.apple.Safari ]] && ! ls ~/Library/Containers/com.apple.Safari/Data >/dev/null 2>&1; then
    warn "Safari settings skipped: turn on this terminal in System Settings → Privacy & Security → Full Disk Access, reopen it, then run: ./bootstrap macos"
    open "x-apple.systempreferences:com.apple.preference.security?Privacy_AllFiles" 2>/dev/null || true
  fi
  # Applies keyboard shortcut changes without logging out.
  /System/Library/PrivateFrameworks/SystemAdministration.framework/Resources/activateSettings -u 2>/dev/null || true
  killall Dock Finder SystemUIServer ControlCenter 2>/dev/null || true
  ok "macOS defaults applied"
}

# Prints the "After it finishes" list from the README, so there's one copy.
step_checklist() {
  echo "  Left to do (from README.md):"
  sed -n '/<!-- checklist:start -->/,/<!-- checklist:end -->/{/<!--/d;p;}' "$REPO/README.md" | sed 's/^/  /'
}

###############################################################################
# Main
###############################################################################

# Piped from curl: fetch the repo, then run its copy of this script.
if [[ ! -f ${BASH_SOURCE[0]} ]]; then
  require_admin
  dir="${ALUMINIUM_DIR:-$HOME/aluminium}"
  say "xcode"
  step_xcode
  if [[ ! -e $dir/.git ]]; then
    git clone --branch "${ALUMINIUM_REF:-main}" "$REPO_URL" "$dir"
  fi
  # stdin is the curl pipe; prompts need the terminal.
  if (exec </dev/tty) 2>/dev/null; then
    exec "$dir/bootstrap" "$@" </dev/tty
  fi
  exec "$dir/bootstrap" "$@"
fi

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
load_brew || true

if [[ $# -eq 0 ]]; then
  set -- "${STEPS[@]}"
fi
for s in "$@"; do
  if ! declare -F "step_$s" >/dev/null; then
    echo "Unknown step: $s. Steps: ${STEPS[*]}" >&2
    exit 1
  fi
done
# Fail before any prompts rather than halfway through.
for s in "$@"; do
  case $SUDO_STEPS in *" $s "*) require_admin; break ;; esac
done

for s in "$@"; do
  say "$s"
  "step_$s"
done

if [[ ${#WARNINGS[@]} -gt 0 ]]; then
  say "Needs attention"
  for w in "${WARNINGS[@]}"; do printf '  ! %s\n' "$w"; done
fi
